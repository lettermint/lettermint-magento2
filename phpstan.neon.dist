parameters:
    level: 5
    paths:
        - Model
        - Plugin
        - Service
        - Test
    bootstrapFiles:
        - Test/Unit/bootstrap.php
    tmpDir: .phpstan
    ignoreErrors:
        # CI analyses against the latest Magento. Magento 2.4.7 and older use
        # Laminas MIME instead of Symfony MIME; the extractor and the tests
        # handle both.
        -
            identifier: class.notFound
            message: '#Laminas\\Mime\\#'
            paths:
                - Service/EmailContentExtractor.php
                - Test/*
        -
            identifier: function.alreadyNarrowedType
            message: '#getSymfonyMessage#'
            path: Test/Unit/MagentoMessages.php
