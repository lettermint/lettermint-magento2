{
    "name": "lettermint/magento2-lettermint",
    "description": "Lettermint Email Integration for Magento 2",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Bjarn Bronsveld",
            "email": "bjarn@lettermint.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "magento/framework": ">=103.0",
        "lettermint/lettermint-php": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Lettermint\\Email\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/",
            "only": [
                "magento/*"
            ]
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false
        }
    },
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
